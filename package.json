{
  "name": "datong-platform",
  "private": true,
  "version": "0.1.0",
  "description": "臺北市大同發展中心 營運管理暨評鑑品質追蹤平台",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "stack:start": "bash dev-stack/start.sh",
    "stack:stop": "bash dev-stack/stop.sh",
    "stack:reset": "bash dev-stack/start.sh reset",
    "bootstrap:director": "tsx scripts/bootstrap-director.ts",
    "import:v5": "tsx scripts/import/import-v5.ts",
    "dev:users": "tsx scripts/dev-users.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "mail:send": "tsx scripts/send-email.ts",
